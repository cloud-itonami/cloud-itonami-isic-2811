(ns turbine.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  connecting-rod / cylinder-head bolt tensile proof-load simulation
  (`turbine.robotics/run-bolt-proof-load-test`) over a fixed sweep of
  rod-bolt masses and print ONE EDN map of the physical quantities it
  computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2811/SOUL.md)
  reads every tick. Every number is derived from a time-stepped trajectory
  by `turbine.robotics`, never typed in. Output schema
  `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-2811\"
     :procedure \"...\"
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n               ; runs that produced numeric quantities
     :expected  n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [turbine.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep-rod-bolt-masses-kg
  "Rod-bolt effective masses swept each tick. 1.5 / 2.5 / 2.6 / 2.7 / 2.8 kg
  are the fixtures `turbine.store` seeds (1.5 kg is the under-spec unit);
  5.0 kg brackets above the proof-load floor so a solver change shows up
  as a change in slope, not only in one point."
  [1.5 2.5 2.6 2.7 2.8 5.0])

(defn- telemetry [mass-kg]
  (robotics/bolt-proof-load-telemetry-for {:rod-bolt-mass-kg mass-kg}))

(defn- run-one [mass-kg]
  (let [t (telemetry mass-kg)]
    {:input {:rod-bolt-mass-kg mass-kg}
     :quantities t
     :out-of-tolerance? (robotics/rod-bolt-proof-load-out-of-tolerance? t)}))

(defn min-passing-rod-bolt-mass-kg
  "Smallest rod-bolt effective mass whose simulated proof-load force reaches
  `robotics/min-rod-bolt-proof-load-n`, by bisection over the REAL simulation
  (force is monotone in mass at fixed speed/travel -- pinned by
  `robotics-test`). nil when the bracket does not straddle the floor."
  ([] (min-passing-rod-bolt-mass-kg 0.01 100.0 40))
  ([lo hi iters]
   (let [below? (fn [m] (robotics/rod-bolt-proof-load-out-of-tolerance? (telemetry m)))]
     (when (and (below? lo) (not (below? hi)))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           hi
           (let [mid (/ (+ lo hi) 2.0)]
             (if (below? mid)
               (recur mid hi (inc i))
               (recur lo mid (inc i))))))))))

(defn probe []
  (let [runs (mapv run-one sweep-rod-bolt-masses-kg)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-proof-load-force])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2811"
     :procedure "Connecting-rod / cylinder-head TTY bolt tensile proof-load pull test (robot fastener-qualification cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:min-rod-bolt-proof-load-n robotics/min-rod-bolt-proof-load-n
               :min-passing-rod-bolt-mass-kg (min-passing-rod-bolt-mass-kg)}
     :count (count (filter numeric? runs))
     :expected (count sweep-rod-bolt-masses-kg)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
